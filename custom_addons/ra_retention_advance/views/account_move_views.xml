<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_move_form_ra" model="ir.ui.view">
        <field name="name">account.move.form.ra</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_move_form"/>
        <field name="arch" type="xml">
            <xpath expr="//notebook" position="inside">
                <page string="Retention and Advance" name="ra_tab"
                      invisible="move_type not in ('out_invoice', 'out_refund')">
                    <field name="commercial_partner_id" invisible="1"/>
                    <group>
                        <group string="Retention" name="ra_retention">
                            <field name="retention_percent"
                                   readonly="state != 'draft' or move_type == 'out_refund'"/>
                            <field name="retention_due_date"
                                   readonly="state != 'draft'"
                                   invisible="move_type == 'out_refund'"
                                   required="move_type == 'out_invoice' and retention_percent > 0"/>
                            <field name="retention_amount"/>
                            <field name="retention_held" invisible="state != 'posted' or move_type == 'out_refund'"/>
                            <field name="retention_released" invisible="state != 'posted' or move_type == 'out_refund'"/>
                            <field name="retention_balance" invisible="state != 'posted' or move_type == 'out_refund'"/>
                        </group>
                        <group string="Advance Recovery" name="ra_advance">
                            <field name="advance_payment_id"
                                   readonly="state != 'draft'"
                                   invisible="move_type == 'out_refund'"
                                   options="{'no_create': True}"/>
                            <field name="advance_recovery_type"
                                   readonly="state != 'draft'"
                                   invisible="move_type == 'out_refund'"/>
                            <field name="advance_recovery_percent"
                                   readonly="state != 'draft'"
                                   invisible="move_type == 'out_refund' or advance_recovery_type != 'percent'"/>
                            <field name="advance_recovery_fixed"
                                   readonly="state != 'draft'"
                                   invisible="move_type == 'out_refund' or advance_recovery_type != 'fixed'"/>
                            <field name="advance_recovery_amount"/>
                        </group>
                    </group>
                    <group>
                        <group name="ra_result">
                            <field name="ra_sale_order_id"/>
                            <field name="amount_total" string="Invoice Total (with VAT)"/>
                            <field name="amount_to_pay_now" class="fw-bold"/>
                        </group>
                    </group>
                    <field name="ra_linked_entry_ids" readonly="1"
                           invisible="move_type != 'out_invoice' or state != 'posted'">
                        <list>
                            <field name="date"/>
                            <field name="name"/>
                            <field name="ra_type"/>
                            <field name="ra_currency_id" column_invisible="1"/>
                            <field name="ra_amount_currency"/>
                        </list>
                    </field>
                </page>
            </xpath>
        </field>
    </record>
</odoo>
