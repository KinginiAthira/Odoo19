<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_account_payment_form_ra" model="ir.ui.view">
        <field name="name">account.payment.form.ra</field>
        <field name="model">account.payment</field>
        <field name="inherit_id" ref="account.view_account_payment_form"/>
        <field name="arch" type="xml">
            <xpath expr="//sheet" position="inside">
                <group string="Advance (Retention and Advance module)" name="ra_advance_group"
                       invisible="payment_type != 'inbound' or partner_type != 'customer'">
                    <group>
                        <field name="ra_is_advance"/>
                        <field name="ra_sale_order_id" invisible="not ra_is_advance"/>
                    </group>
                    <group>
                        <field name="ra_advance_residual" invisible="not ra_is_advance"/>
                    </group>
                </group>
            </xpath>
        </field>
    </record>
</odoo>
