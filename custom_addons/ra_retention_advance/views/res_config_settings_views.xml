<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="res_config_settings_view_form_ra" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.inherit.ra</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="account.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//app[@name='account']" position="inside">
                <block title="Retention and Advance" name="ra_settings_block">
                    <setting string="Retention Receivable Account"
                             help="Account where the retention held by the client is kept until handover.">
                        <field name="ra_retention_account_id"/>
                    </setting>
                    <setting string="Default Retention %"
                             help="Proposed on every new customer invoice.">
                        <field name="ra_default_retention_percent"/>
                    </setting>
                    <setting string="Journal for Retention and Advance Entries"
                             help="Miscellaneous journal used for the generated entries.">
                        <field name="ra_journal_id"/>
                    </setting>
                </block>
            </xpath>
        </field>
    </record>
</odoo>
