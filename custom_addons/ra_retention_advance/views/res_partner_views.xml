<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_partner_form_ra" model="ir.ui.view">
        <field name="name">res.partner.form.ra</field>
        <field name="model">res.partner</field>
        <field name="inherit_id" ref="base.view_partner_form"/>
        <field name="arch" type="xml">
            <xpath expr="//div[@name='button_box']" position="inside">
                <button type="action" class="oe_stat_button" icon="fa-unlock"
                        name="%(ra_retention_advance.action_ra_release_wizard_partner)d"
                        string="Release Retention"/>
            </xpath>
        </field>
    </record>
</odoo>
